{
  "id": "optionable-iv-rank-liquid",
  "sentence": "optionable stocks over $5 with IV rank above 50% and $50M traded a day",
  "split": "train",
  "expect": {
    "parts": [
      {
        "span": "optionable",
        "bucket": "A",
        "fields": [
          "instrument.optionable"
        ],
        "op": "eq",
        "value": true,
        "tolerance": 0
      },
      {
        "span": "over $5",
        "bucket": "A",
        "fields": [
          "rollup.price_stats@v2.close",
          "rollup.option_liquidity@v1.underlying_price"
        ],
        "op": [
          "gt",
          "gte"
        ],
        "value": 5,
        "tolerance": 0
      },
      {
        "span": "IV rank above 50%",
        "bucket": "A",
        "fields": [
          "feature.iv_rank",
          "rollup.iv_history@v2.iv_rank_252d"
        ],
        "op": [
          "gt",
          "gte"
        ],
        "value": 0.5,
        "tolerance": 0
      },
      {
        "span": "$50M traded a day",
        "bucket": "A",
        "fields": [
          "rollup.price_stats@v2.adv_usd_20d"
        ],
        "op": "gte",
        "value": 50000000,
        "tolerance": 0.1
      }
    ],
    "scope_fields": [
      "instrument.status",
      "instrument.security_type"
    ]
  }
}
