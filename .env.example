# Copy to .env (git-ignored). Apps read configuration only from environment variables.
# Where all data lives, read by every app. Prefer an absolute path, e.g.
# file:///Users/me/algotrade-data, so it does not depend on the working directory.
# s3://bucket/prefix is planned (docs/data/storage.md, "Moving to S3"); not supported yet.
ALGOTRADE_DATA_URL=file://./var/data
# Who may call the API (ADR 0040). "off": serve ALGOTRADE_USER without a token (loopback only),
# until the Supabase project exists; "supabase" (the default) needs SUPABASE_URL, and each user's
# sign-in email in config/users/<id>/identity.toml.
ALGOTRADE_AUTH=off
# SUPABASE_URL=https://<project-ref>.supabase.co
# The web app signs in with the same project: put VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
# (the public anon key) in apps/web/.env.local (Vite reads them from there, not from this file).
# The web origins the API allows (CORS), comma-separated; unset: the local dev server
# (localhost / 127.0.0.1, ports 5173 and 3000). Only for a web served from another origin: the
# hosted setup (docs/hosting.md) serves the web from the API's own origin and needs none.
# ALGOTRADE_CORS_ORIGINS=https://app.example.com
# Hosting (ADR 0044, docs/hosting.md): the built web app the API serves on its own origin
# (`make web-build` writes var/web); unset: the API serves no files.
# ALGOTRADE_WEB_DIST=var/web
# The legacy HS256 secret (Project Settings -> API -> JWT secret); unset: JWKS keys only.
# SUPABASE_JWT_SECRET=
# Vendor credentials are used only by apps/ingestion.
# Free key from https://massive.com (sent as a header, never stored in raw files or URLs)
ALGOTRADE_MASSIVE_API_KEY=
# SEC EDGAR requires a contact email in the User-Agent (fair-access policy), e.g. you@example.com
ALGOTRADE_SEC_CONTACT=
# Free key from https://fredaccount.stlouisfed.org (FRED / ALFRED economic series, ADR 0048); FRED
# takes it only as a query parameter, which the transport adds (never in a URL we build or log)
ALGOTRADE_FRED_API_KEY=
# IB Gateway for the read-only `verify` task (config/site/sources.toml [ibkr], ADR 0026):
# 4001 = live gateway, 4002 = paper. Tick "Read-Only API" in the gateway's API settings.
ALGOTRADE_IBKR_HOST=127.0.0.1
ALGOTRADE_IBKR_PORT=4002
ALGOTRADE_IBKR_CLIENT_ID=1
# Nightly summary email (config/site/nightly.toml [notify.email] enabled = true to send).
# Recipients (comma-separated) and sender; the sender defaults to the first recipient.
ALGOTRADE_NOTIFY_EMAIL_TO=
ALGOTRADE_NOTIFY_EMAIL_FROM=
# SMTP login. Gmail: the address as user and an App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), never your account password.
ALGOTRADE_SMTP_USER=
ALGOTRADE_SMTP_PASSWORD=
