# Copy to .env (git-ignored). Apps read configuration only from environment variables.
# Where all data lives, read by every app. Prefer an absolute path, e.g.
# file:///Users/me/algotrade-data, so it does not depend on the working directory.
# s3://bucket/prefix is planned (docs/data/storage.md, "Moving to S3"); not supported yet.
ALGOTRADE_DATA_URL=file://./var/data
# Vendor credentials are used only by apps/ingestion.
# Free key from https://massive.com (sent as a header, never stored in raw files or URLs)
ALGOTRADE_MASSIVE_API_KEY=
# SEC EDGAR requires a contact email in the User-Agent (fair-access policy), e.g. you@example.com
ALGOTRADE_SEC_CONTACT=
ALGOTRADE_IBKR_HOST=127.0.0.1
ALGOTRADE_IBKR_PORT=4002
ALGOTRADE_IBKR_CLIENT_ID=1
