{
  "name": "@algotrade/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "src/pages/trader-*/index.ts"
  ],
  "description": "The algotrade web UI (ADR 0011, ADR 0025). Layered, component-only: see docs/ui/architecture.md.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "design-system"
  ],
  "scripts": {
    "predev": "node scripts/check-node-modules.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings=0 . && stylelint \"design-system/**/*.css\" && prettier --check .",
    "format": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prestorybook": "node scripts/check-node-modules.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet -o storybook-static",
    "e2e": "playwright test",
    "visual": "playwright test -c playwright.visual.config.ts",
    "visual:docker": "scripts/in-playwright-docker.sh npm run visual",
    "visual:update": "scripts/in-playwright-docker.sh npm run visual -- --update-snapshots",
    "perf:bundle": "tsx scripts/check-bundle-budgets.ts",
    "perf:e2e": "playwright test -c playwright.perf.config.ts",
    "tokens": "tsx scripts/generate-tokens.ts",
    "components:md": "tsx scripts/generate-components-md.ts",
    "api:generate": "tsx scripts/generate-api.ts && graphql-codegen --config codegen.ts",
    "ds:check": "tsx scripts/check-design-system.ts",
    "audit:check": "tsx scripts/check-audit.ts",
    "generated:check": "npm run tokens && npm run components:md && npm run api:generate && git diff --exit-code -- design-system/tokens/tokens.css design-system/COMPONENTS.md src/shared/api/generated",
    "check": "npm run generated:check && npm run ds:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run storybook:build && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/client-preset": "^6.2.2",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "graphql": "^17.0.2",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "//": [
    "overrides.handlebars: @boundaries/elements@3.1.1 (the latest, via eslint-plugin-boundaries@7.2.0) pins handlebars 4.7.9, affected by GHSA-8r5x-fm3f-whwj, GHSA-p8wg-vrv2-v86f (critical) and GHSA-xw65-4hp5-5hc7; 4.7.10 is the patch release that fixes them. Drop the override when @boundaries/elements ships with handlebars >= 4.7.10 (added 2026-10-08)."
  ],
  "overrides": {
    "handlebars": "^4.7.10"
  },
  "dependencies": {
    "@algotrade/ui": "^0.0.0",
    "@supabase/auth-js": "2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "idb-keyval": "6.3.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
